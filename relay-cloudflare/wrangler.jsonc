{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baby-monitor-secure-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomV4"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    },
    {
      "tag": "v2-pairing-reset-2026-09-01",
      "new_sqlite_classes": ["RoomV4"],
      "deleted_classes": ["Room"]
    }
  ]
}
